PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/college_erp
USE_IN_MEMORY_DB=true
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COLLEGE_NAME=JB Institute of Technology
COLLEGE_CODE=JBIT-101
COLLEGE_ADDRESS=Knowledge Park III, Institutional Area, Greater Noida, UP - 201306
COLLEGE_EMAIL=support@jbit.edu.in
COLLEGE_PHONE=+91 9876543210

# ===================================================================
# Email Service Configuration (Institutional Sender Account)
#
# IMPORTANT: The account below is the SENDER ONLY.
# Verification OTPs are dynamically sent to each student's entered/registered
# Gmail address (e.g., studentA@gmail.com, studentB@gmail.com).
# Never use a student's personal email as the EMAIL_USER.
# For Gmail, generate an App Password at: https://myaccount.google.com/apppasswords
# ===================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=institutional_erp_sender@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
EMAIL_FROM="JB Institute of Technology <noreply@jbit.edu.in>"
